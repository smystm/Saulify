# ---------------------------------------------------------------------------
# GitHub (optional, strongly recommended in production)
# A fine-grained public-repository read token raises the API quota from 60 to
# 5,000 requests/hour. Never expose this value to the browser.
# ---------------------------------------------------------------------------
GITHUB_TOKEN=

# Reject repositories larger than this many megabytes.
MAX_REPO_SIZE_MB=250

# ---------------------------------------------------------------------------
# AI reviewer (optional)
# Values: auto | opencode | openai-compatible | ollama | off
# If omitted, Saulify runs deterministic static analysis only.
# ---------------------------------------------------------------------------

# OpenCode Zen / OpenAI-compatible provider
AI_PROVIDER=auto
# OPENCODE_API_KEY=
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# Generic OpenAI-compatible endpoint
# AI_BASE_URL=https://your-provider.example/v1
# AI_API_KEY=
# AI_MODEL=

# Local Ollama (no API key required)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5-coder:7b
